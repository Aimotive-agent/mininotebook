# ---- LLM (any OpenAI-compatible endpoint) ----
LLM_BASE=https://api.deepseek.com/v1
LLM_KEY=sk-your-key-here
LLM_MODEL=deepseek-flash
# Vision model used to OCR scanned PDFs / images
OCR_MODEL=deepseek-flash

# ---- Embeddings (Ollama) ----
# Install Ollama and run:  ollama pull embeddinggemma
OLLAMA_URL=http://host.docker.internal:11434
EMBED_MODEL=embeddinggemma:latest

# ---- Storage ----
DATA_DIR=/data
